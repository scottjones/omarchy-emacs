post_install() {
  cat <<EOF
==> Run 'omarchy-emacs-setup' to install the user-side config in
    ~/.config/emacs/. The package itself only ships files under
    /usr/share/omarchy-emacs/.
EOF
}

post_upgrade() {
  cat <<EOF
==> omarchy-emacs was upgraded. Re-run 'omarchy-emacs-setup' to refresh
    the managed ~/.config/emacs/omarchy.el (and other managed files).
    Without this step, fixes shipped in the upgrade won't reach Emacs.
EOF
}
