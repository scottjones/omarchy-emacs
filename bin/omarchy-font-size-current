#!/bin/bash

# Return the font size configured in the default terminal emulator.
# Reads ~/.config/xdg-terminals.list to determine which terminal is active,
# then extracts the font size from that terminal's config file.

# Resolve the active terminal by finding the first installed entry in xdg-terminals.list,
# matching what xdg-terminal-exec does at launch time.
resolve_terminal() {
  local entry desktop
  while IFS= read -r entry; do
    entry=$(echo "$entry" | sed 's/#.*//' | xargs)
    [[ -z $entry ]] && continue
    for dir in ~/.local/share/applications /usr/share/applications /usr/local/share/applications; do
      if [[ -f "$dir/$entry" ]]; then
        echo "$entry"
        return
      fi
    done
  done < ~/.config/xdg-terminals.list 2>/dev/null

  # Fallback: check which terminal is actually installed
  for candidate in com.mitchellh.ghostty.desktop kitty.desktop Alacritty.desktop; do
    for dir in ~/.local/share/applications /usr/share/applications /usr/local/share/applications; do
      if [[ -f "$dir/$candidate" ]]; then
        echo "$candidate"
        return
      fi
    done
  done
}

term=$(resolve_terminal)

case "$term" in
  *[Aa]lacritty*)
    sed -n '/^\[font\]/,/^\[/p' ~/.config/alacritty/alacritty.toml 2>/dev/null \
      | grep -oP '^size\s*=\s*\K[0-9]+\.?[0-9]*'
    ;;
  *kitty*)
    grep -oP '^font_size\s+\K[0-9]+\.?[0-9]*' ~/.config/kitty/kitty.conf 2>/dev/null
    ;;
  *ghostty*)
    grep -oP '^font-size\s*=\s*\K[0-9]+\.?[0-9]*' ~/.config/ghostty/config 2>/dev/null
    ;;
esac
