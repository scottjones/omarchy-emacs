#!/bin/bash

# Set up Omarchy Emacs configuration for the current user

SHARE_DIR="/usr/share/omarchy-emacs"
CONFIG_DIR="$HOME/.config/emacs"
THEMED_DIR="$HOME/.config/omarchy/themed"

mkdir -p "$CONFIG_DIR/themes"
mkdir -p "$THEMED_DIR"

# Detect legacy ~/.emacs which takes precedence over ~/.config/emacs/init.el
if [[ -f "$HOME/.emacs" ]]; then
  echo "WARNING: ~/.emacs exists and will override ~/.config/emacs/init.el, preventing Omarchy integration."
  echo "If you move it, add any customizations you want to keep to ~/.config/emacs/init.el instead."
  read -r -p "Move ~/.emacs to ~/.emacs.bak? [y/N] " response
  if [[ "${response,,}" == "y" ]]; then
    mv "$HOME/.emacs" "$HOME/.emacs.bak"
    echo "Moved ~/.emacs to ~/.emacs.bak — review it and migrate any customizations to ~/.config/emacs/init.el"
  else
    echo "Skipping. Note: Omarchy theme/font integration will not work until ~/.emacs is removed or renamed."
  fi
fi

# Detect legacy ~/.emacs.d which takes precedence over ~/.config/emacs/
if [[ -d "$HOME/.emacs.d" ]]; then
  echo "WARNING: ~/.emacs.d exists and will override ~/.config/emacs/, preventing Omarchy integration."
  echo "If you move it, add any customizations you want to keep to ~/.config/emacs/init.el instead."
  read -r -p "Move ~/.emacs.d to ~/.emacs.d.bak? [y/N] " response
  if [[ "${response,,}" == "y" ]]; then
    mv "$HOME/.emacs.d" "$HOME/.emacs.d.bak"
    echo "Moved ~/.emacs.d to ~/.emacs.d.bak — review it and migrate any customizations to ~/.config/emacs/init.el"
  else
    echo "Skipping. Note: Omarchy theme/font integration will not work until ~/.emacs.d is removed or renamed."
  fi
fi

# Write omarchy.el as a thin shim that loads the package-installed
# implementation from $SHARE_DIR. This way pacman/AUR upgrades update
# the integration code in place — re-running setup isn't required to
# pick up new code, just an Emacs reload (omarchy-restart-emacs).
cat > "$CONFIG_DIR/omarchy.el" <<EOF
;;; omarchy.el --- Omarchy Emacs integration shim -*- lexical-binding: t -*-
;;; Managed by omarchy-emacs. Loads the package-installed implementation so
;;; that AUR upgrades propagate without re-running omarchy-emacs-setup.
;;; Put your personal customizations in init.el instead.

(let ((omarchy--system-file "$SHARE_DIR/config/omarchy.el"))
  (when (file-exists-p omarchy--system-file)
    (load omarchy--system-file)))

;;; omarchy.el ends here
EOF

# Copy user-owned files only if they don't exist yet
for file in init.el shell-bashrc; do
  if [[ ! -f "$CONFIG_DIR/$file" ]]; then
    cp "$SHARE_DIR/config/$file" "$CONFIG_DIR/$file"
  fi
done

# Theme is managed by omarchy-emacs (always overwrite).
cp "$SHARE_DIR/config/themes/omarchy-theme.el" "$CONFIG_DIR/themes/omarchy-theme.el"

# Remove legacy split themes from upgrades (<1.9). Safe — they're managed files.
rm -f "$CONFIG_DIR/themes/omarchy-dark-theme.el" "$CONFIG_DIR/themes/omarchy-light-theme.el"

# Install font-set and theme-set hooks to sync Emacs on font/theme changes.
#
# Omarchy 4 runs every script in <type>.d/ in addition to the single <type>
# file, so we install a distinctly-named drop-in (<type>.d/omarchy-emacs).
# That coexists with any other hook the user keeps (e.g. a custom RGB-sync
# theme-set) instead of fighting over the one <type> slot — the collision
# that otherwise leaves Emacs unsynced. Omarchy 3 has no .d support, so there
# we fall back to the historical single <type> file, preserving a
# user-customized one (managed marker removed) exactly as before.
HOOKS_DIR="$HOME/.config/omarchy/hooks"
mkdir -p "$HOOKS_DIR"

# .d hook directories arrived with the Omarchy 4 hook system; omarchy-hook-install
# is the CLI added alongside that support, so its presence is a safe O4 signal.
if command -v omarchy-hook-install &>/dev/null; then
  hook_dropins=1
else
  hook_dropins=
fi

# True when FILE is one we own: it carries the managed marker, or its only
# executable line is `omarchy-restart-emacs` (a pre-marker copy from an older
# install). Such a file is safe to replace or retire; anything else is the
# user's own hook and must be left alone.
omarchy_emacs_owns_hook() {
  local file=$1
  [[ -f $file ]] || return 1
  grep -q "omarchy-emacs:managed" "$file" && return 0
  local body
  body=$(grep -vE '^[[:space:]]*(#.*)?$' "$file" | tr -d '[:space:]')
  [[ $body == "omarchy-restart-emacs" ]]
}

for hook in font-set theme-set; do
  if [[ -n $hook_dropins ]]; then
    # Omarchy 4: managed drop-in, always refreshed — the omarchy-emacs name is
    # ours, so there is nothing of the user's to preserve.
    install -Dm755 "$SHARE_DIR/hooks/$hook" "$HOOKS_DIR/$hook.d/omarchy-emacs"
    # Retire a single-file copy we own so the hook doesn't fire twice; leave a
    # genuinely custom single-file hook (marker removed, real commands) alone.
    if omarchy_emacs_owns_hook "$HOOKS_DIR/$hook"; then
      rm -f "$HOOKS_DIR/$hook"
    fi
  else
    # Omarchy 3: single-file hook. Overwrite when missing or managed; preserve
    # a customized one (marker removed).
    HOOK_FILE="$HOOKS_DIR/$hook"
    if [[ ! -f "$HOOK_FILE" ]] || grep -q "omarchy-emacs:managed" "$HOOK_FILE"; then
      cp "$SHARE_DIR/hooks/$hook" "$HOOK_FILE"
      chmod +x "$HOOK_FILE"
    else
      echo "Note: ~/.config/omarchy/hooks/$hook is customized (no managed marker) — leaving it alone."
      echo "      If it's actually a stale copy from a prior install, replace it with:"
      echo "        cp $SHARE_DIR/hooks/$hook $HOOK_FILE && chmod +x $HOOK_FILE"
      echo "      Otherwise ensure it calls 'omarchy-restart-emacs' to keep Emacs in sync."
    fi
  fi
done

# Install the color template
if [[ ! -f "$THEMED_DIR/omarchy-colors.el.tpl" ]]; then
  cp "$SHARE_DIR/omarchy-colors.el.tpl" "$THEMED_DIR/"
fi

# Generate colors for the current theme
if command -v omarchy-theme-set &>/dev/null; then
  theme=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null)
  if [[ -n $theme ]]; then
    omarchy-theme-set "$theme"
  fi
fi

echo "Omarchy Emacs setup complete!"
