#!/bin/bash

# Reload Emacs theme and font to match Omarchy. No-op when the Emacs
# daemon isn't running — otherwise emacsclient exits 1 and any caller
# (e.g. omarchy-hook) reports a spurious "Hook failed" on every theme
# or font change.

if command -v emacsclient &>/dev/null && emacsclient --eval t &>/dev/null; then
  emacsclient --no-wait --eval \
    "(progn
       ;; Configs that load the integration themselves (e.g. a Doom setup
       ;; loading the packaged omarchy.el from ~/.emacs.d) already have
       ;; omarchy-apply-theme bound. Only fall back to loading a shim
       ;; otherwise — and don't assume the shim lives in ~/.config/emacs.
       (unless (fboundp 'omarchy-apply-theme)
         (let ((shim (seq-find
                      #'file-exists-p
                      (list (expand-file-name \"omarchy.el\" user-emacs-directory)
                            (expand-file-name \"~/.config/emacs/omarchy.el\")))))
           (when shim
             (load-file shim))))
       (when (fboundp 'omarchy-apply-theme)
         (dolist (f (frame-list))
           (with-selected-frame f
             (omarchy-apply-theme)
             (omarchy-apply-font)))))" \
    2>/dev/null
fi
